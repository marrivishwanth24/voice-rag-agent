# Claude for voice-synthesized answers
ANTHROPIC_API_KEY=sk-ant-...

# The RAG Agent Platform this project calls into (defaults to the live deploy)
RAG_API_URL=https://rag-agent-platform-production.up.railway.app

# A session ID on the RAG platform that already has documents uploaded under
# it. Get one by uploading a PDF through the RAG platform's web UI or
# /upload endpoint, then copying the X-Session-ID it was uploaded under
# (stored in that site's localStorage, key "sessionId").
RAG_SESSION_ID=

# Twilio — from console.twilio.com (not used directly by the app yet, but
# needed once you configure the phone number's webhook; see README)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
